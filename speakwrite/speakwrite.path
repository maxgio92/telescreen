[Unit]
Description=run speakwrite when a dictation intent or a publish approval lands in recdep/intents/

[Path]
PathExistsGlob=%S/recdep/intents/*.intent
PathExistsGlob=%S/recdep/intents/*.publish
# an intent surviving a dead claude run would otherwise re-trigger back to back
TriggerLimitIntervalSec=1h
TriggerLimitBurst=6

[Install]
WantedBy=paths.target
