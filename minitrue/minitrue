#!/usr/bin/env bash
# minitrue: the personal-watch producer. poll the four watches, enqueue hits. Run by the timer.
# timeout + </dev/null so the process always exits (claude -p can hang on
# teardown), which lets the oneshot complete and the timer reschedule.
# ~/.config/minitrue.env sets the parameters (plain KEY=value lines);
# the defaults below apply without it.
set -a
[ -f "$HOME/.config/minitrue.env" ] && . "$HOME/.config/minitrue.env"
set +a
AGENT="${MINITRUE_AGENT:-claude}"
PROMPT="${MINITRUE_PROMPT:-/minitrue produce}"
ALLOWED_TOOLS="${MINITRUE_ALLOWED_TOOLS:-Bash Read Write Glob Grep mcp__plugin_slack_slack__slack_search_public_and_private mcp__plugin_slack_slack__slack_read_thread mcp__linear-server__list_issues mcp__linear-server__list_comments}"
TIMEOUT="${MINITRUE_TIMEOUT:-600}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/recdep"
mkdir -p "$STATE/tube" "$STATE/desk" "$STATE/upsub" "$STATE/files"
exec timeout "$TIMEOUT" "$AGENT" -p "$PROMPT" \
  --allowedTools "$ALLOWED_TOOLS" \
  </dev/null >>"$STATE/produce.log" 2>&1
